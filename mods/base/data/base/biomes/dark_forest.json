{
  "id": "base:dark_forest",
  "description": "Dense, shaded forest.",
  "climate": {
    "temperature": {
      "center": 0.05,
      "extent": 0.3
    },
    "humidity": {
      "center": 0.5,
      "extent": 0.3
    },
    "height": [
      0,
      110
    ]
  },
  "surface": [
    {
      "block": "base:clay",
      "when": {
        "river_min": 0.55,
        "patch": {
          "noise": "b",
          "lo": 0.3,
          "hi": 2
        }
      }
    },
    {
      "block": "base:gravel",
      "when": {
        "river_min": 0.55
      }
    },
    {
      "block": "base:mud",
      "when": {
        "river_min": 0.4
      }
    },
    {
      "block": "base:andesite",
      "when": {
        "slope_min": 5,
        "patch": {
          "noise": "a",
          "lo": 0.25,
          "hi": 2
        }
      }
    },
    {
      "block": "base:granite",
      "when": {
        "slope_min": 5,
        "patch": {
          "noise": "a",
          "lo": -2,
          "hi": -0.25
        }
      }
    },
    {
      "block": "base:stone",
      "when": {
        "slope_min": 5
      }
    },
    {
      "block": "base:podzol",
      "when": {
        "patch": {
          "noise": "a",
          "lo": -2,
          "hi": 0.3
        }
      }
    },
    {
      "block": "base:moss_block",
      "when": {
        "patch": {
          "noise": "b",
          "lo": 0.5,
          "hi": 2
        }
      }
    },
    {
      "block": "base:grass_block"
    },
    {
      "block": "base:dirt",
      "depth": 3
    }
  ],
  "plants": [
    {
      "block": "base:mushroom",
      "chance": 5,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    },
    {
      "block": "base:fern",
      "chance": 10,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    },
    {
      "block": "base:tall_grass",
      "chance": 6,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    }
  ],
  "tree_density_scale": 1.3,
  "features": [
    {
      "id": "base:dark_boulder",
      "block": "base:mossy_cobble_cold",
      "chance_per_mille": 4,
      "radius": 1
    },
    {
      "id": "base:dark_mound",
      "block": "base:podzol",
      "chance_per_mille": 8,
      "radius": 1
    }
  ]
}
