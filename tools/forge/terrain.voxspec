# Terrain overhaul textures. Build: forge.py build --spec tools/forge/terrain.voxspec --out <dir> --size 16 --seed 1337 --variants 1 --qa --atlas --report
# Naming: <family>.<name>. tools/forge_import.py maps families to engine block textures.

