{
  "id": "base:meadow",
  "description": "Flowery grassland with scattered trees.",
  "climate": {
    "temperature": {
      "center": 0.2,
      "extent": 0.3
    },
    "humidity": {
      "center": -0.05,
      "extent": 0.3
    },
    "height": [
      0,
      110
    ]
  },
  "surface": [
    {
      "block": "base:clay",
      "when": {
        "river_min": 0.55,
        "patch": {
          "noise": "b",
          "lo": 0.3,
          "hi": 2
        }
      }
    },
    {
      "block": "base:gravel",
      "when": {
        "river_min": 0.55
      }
    },
    {
      "block": "base:mud",
      "when": {
        "river_min": 0.4
      }
    },
    {
      "block": "base:andesite",
      "when": {
        "slope_min": 5,
        "patch": {
          "noise": "a",
          "lo": 0.25,
          "hi": 2
        }
      }
    },
    {
      "block": "base:granite",
      "when": {
        "slope_min": 5,
        "patch": {
          "noise": "a",
          "lo": -2,
          "hi": -0.25
        }
      }
    },
    {
      "block": "base:stone",
      "when": {
        "slope_min": 5
      }
    },
    {
      "block": "base:grass_block"
    },
    {
      "block": "base:dirt",
      "depth": 3
    }
  ],
  "plants": [
    {
      "block": "base:daisy",
      "chance": 3,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    },
    {
      "block": "base:cornflower",
      "chance": 2,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    },
    {
      "block": "base:lavender",
      "chance": 1,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    },
    {
      "block": "base:flower_yellow",
      "chance": 2,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    },
    {
      "block": "base:meadow_grass",
      "chance": 16,
      "on": [
        "base:grass_block",
        "base:podzol",
        "base:moss_block"
      ]
    }
  ],
  "tree_density_scale": 0.4,
  "features": [
    {
      "id": "base:meadow_outcrop",
      "block": "base:limestone",
      "chance_per_mille": 2,
      "radius": 1
    }
  ]
}
