# logs: bark side and ring end per species
logside.{spruce,acacia,darkoak,jungle,cherry,mangrove} = base(lib.bark) | ramp($1)
logside.birch = base(lib.bark) | stripe(nx=0,ny=5,duty=0.12) | sel(lo=0.5) | ramp(bark) | sel(all) | ramp(birch)
logend.{birch,spruce,acacia,darkoak,jungle,cherry,mangrove} = gradient(mode=ring,n=3~1) | fbm(oct=3,scale=6,mix=add,amt=0.35) | ramp($1) | bevel(w=2)

# leaves: distinct colour and cutout pattern
leaf.birch = fbm(oct=3,scale=6) | mask(leaf_sparse,tex=0.5) | ramp(birchleaf)
leaf.spruce = fbm(oct=3,sx=8,sy=2) | mask(leaf_needle,tex=0.5) | ramp(spruceleaf)
leaf.autumn_red = fbm(oct=3,scale=6) | mask(leaf_dense,tex=0.5) | ramp(autumn_red)
leaf.autumn_orange = fbm(oct=3,scale=6) | mask(leaf_dense,tex=0.5) | ramp(autumn_orange)
leaf.autumn_yellow = fbm(oct=3,scale=6) | mask(leaf_sparse,tex=0.5) | ramp(autumn_yellow)
leaf.cherry = fbm(oct=3,scale=6) | scatter(n=9,r=1.0,mask=dot) | mask(leaf_clump,tex=0.5) | ramp(blossom)
leaf.acacia = fbm(oct=2,sx=6,sy=3) | mask(leaf_clump,tex=0.5) | ramp(acacialeaf)
leaf.jungle = fbm(oct=4,scale=8) | mask(leaf_dense,tex=0.6) | ramp(jungleleaf)
leaf.willow = fbm(oct=3,sx=8,sy=2) | mask(leaf_droop,tex=0.5) | ramp(willowleaf)

# flora (cross-shape cutouts)
flora.{cornflower:flower_blue,daisy:flower_white,orange_poppy:flower_orange} = mask(bloom,tex=0.0) | ramp(shrubgreen,b=$1,c=hay)
flora.pink_tulip = mask(tulip,tex=0.0) | ramp(shrubgreen,b=flower_pink,c=flower_white)
flora.bluebell = mask(bell,tex=0.0) | ramp(shrubgreen,b=flower_blue,c=flower_white)
flora.{lavender:flower_purple,heather:heath} = mask(spike,tex=0.0) | ramp(shrubgreen,b=$1,c=flower_white)
flora.fern = mask(fern,tex=0.0) | ramp(leaf,b=moss,c=leaf)
flora.{dry_grass:dryturf,meadow_grass:lime} = fbm(oct=3,scale=6) | mask(tuft,tex=0.6) | ramp($1,b=sand,c=$1)
flora.berry_bush = mask(bush,tex=0.0) | ramp(leaf,b=berry_red,c=moss)
flora.azalea_bush = mask(bush,tex=0.0) | ramp(leaf,b=flower_pink,c=moss)
flora.snow_shrub = mask(bush,tex=0.0) | ramp(shrubgreen,b=flower_white,c=snow)
flora.cattail = mask(reed,tex=0.0) | ramp(grass,b=reedbrown)
flora.seagrass = fbm(oct=3,scale=6) | mask(blades,tex=0.6) | ramp(seagreen,b=emerald)

# ground and stone
ground.{terracotta_red:terra_red,terracotta_orange:terra_orange,terracotta_white:terra_white} = stripe(nx=0,ny=4~1,duty=0.5) | fbm(oct=3,sx=2,sy=8,mix=add,amt=0.5) | dither(bayer) | ramp($1)
ground.red_sandstone = base(lib.smooth) | ramp(redsandstone)
ground.limestone = base(lib.rock) | ramp(limestone)
ground.tuff = base(lib.rock) | ramp(tuff)
ground.permafrost = base(lib.rock) | ramp(permafrost)
ground.peat = base(lib.soil) | ramp(peat)
ground.dry_grass_top = base(lib.grain) | ramp(dryturf)
face.grass_side.dry = fbm(oct=3,scale=6) | mask(grass_side,tex=0.3) | ramp(dirt,b=dryturf) | bevel
ground.mossy_cobble_cold = base(_cobble.slate) | fbm(oct=3,scale=3~1) | sel(lo=0.58) | fbm(oct=2,scale=8) | ramp(spruceleaf)
ground.mossy_cobble_warm = base(_cobble.sandstone) | fbm(oct=3,scale=3~1) | sel(lo=0.58) | fbm(oct=2,scale=8) | ramp(acacialeaf)
_cobble.slate = base(lib.cobble) | ramp(slate)
_cobble.sandstone = base(lib.cobble) | ramp(sandstone)
